# Set to the final HTTPS site URL in Netlify before building.
NEXT_PUBLIC_SITE_URL=

# Keep disabled until provider accounts and live testing are complete.
NEXT_PUBLIC_OTP_ENABLED=false
# Server-only variables: set in Netlify Functions scope, never NEXT_PUBLIC_.
OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SENDGRID_API_KEY=
OTP_FROM_EMAIL=
OTP_STORAGE_SECRET=
